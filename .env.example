# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Required for ElevenLabs TTS.
# Users configure this via the Secrets panel in the AI Studio UI.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# M2M_API_KEY: (Optional) Hardcoded fallback key for Machine-to-Machine API access.
# If set, this key will always be valid even if not present in Firestore.
M2M_API_KEY=

# Supabase runtime config for the server-side adapter.
SUPABASE_URL="https://rnietcptihkyvmejtsiy.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_uuGBG_8hzgZU7dO4cUhShg_FNuhc_li"
SUPABASE_SERVER_RPC_TOKEN="replace-with-server-rpc-token"
